{
  "name": "jarvis-kit",
  "version": "0.4.0",
  "private": true,
  "description": "Personal engineering harness for AI coding agents.",
  "type": "module",
  "scripts": {
    "test": "node --test \"core/scripts/*.test.mjs\" \"adapters/claude/*.test.mjs\" \"adapters/claude/hooks/*.test.mjs\" \"scripts/*.test.mjs\"",
    "check": "node scripts/check.mjs && claude plugin validate .",
